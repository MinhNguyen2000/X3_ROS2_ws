<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Fast DDS profile: restrict this machine's DDS participant to the lab Wi-Fi address.

  Why: the dev laptop has a wired (131.202.12.37) and a Wi-Fi (192.168.0.104) address. A
  participant advertises both, so the Pi sends every image frame twice (once per address),
  and the wired copy goes through the router. Limiting the participant to the Wi-Fi address
  halves the Pi's transmit rate (measured 6.1 -> 3.1 MB/s for /camera/image_raw/compressed).

  Use: FASTRTPS_DEFAULT_PROFILES_FILE=<this file> (rviz.launch.py sets it for rviz2 only).
  The address is the dongle's DHCP lease; update it if the lease changes.
  The tag must be useBuiltinTransports (plural), otherwise the whitelist is silently ignored.
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>wifi_only</transport_id>
      <type>UDPv4</type>
      <interfaceWhiteList>
        <address>192.168.0.104</address>
      </interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="wifi_only_participant" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>wifi_only</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
